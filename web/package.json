{
	"name": "web",
	"version": "2026.0.1",
	"private": true,
	"scripts": {
		"prepare": "git config --local core.hooksPath .githooks || echo 'Can not set git hooks'",
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix --fix-suggestions --fix-dangerously",
		"qa": "tsc --noEmit -p ./tsconfig.app.json && pnpm run lint",
		"deploy": "wrangler pages deploy dist --project-name gurutzeta",
		"generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/icon.svg"
	},
	"dependencies": {
		"@fontsource/ubuntu": "^5.2.8",
		"@headlessui/react": "^2.2.10",
		"@heroicons/react": "^2.2.0",
		"@sentry/browser": "^10.49.0",
		"@sentry/react": "^10.49.0",
		"contentful": "^11.12.1",
		"diod": "^3.0.0",
		"fluture": "^14.0.0",
		"i18next": "^26.0.6",
		"i18next-browser-languagedetector": "^8.2.1",
		"leaflet": "^1.9.4",
		"ramda": "^0.32.0",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"react-i18next": "^17.0.4",
		"react-leaflet": "^5.0.0",
		"reflect-metadata": "^0.2.2",
		"web-vitals": "^5.2.0",
		"workbox-background-sync": "^7.4.0",
		"workbox-broadcast-update": "^7.4.0",
		"workbox-cacheable-response": "^7.4.0",
		"workbox-core": "^7.4.0",
		"workbox-expiration": "^7.4.0",
		"workbox-navigation-preload": "^7.4.0",
		"workbox-precaching": "^7.4.0",
		"workbox-range-requests": "^7.4.0",
		"workbox-routing": "^7.4.0",
		"workbox-strategies": "^7.4.0",
		"workbox-streams": "^7.4.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.2.2",
		"@types/leaflet": "^1.9.21",
		"@types/node": "^25.6.0",
		"@types/ramda": "^0.31.1",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vitejs/plugin-react-swc": "^4.3.0",
		"add": "^2.0.6",
		"globals": "^17.5.0",
		"lint-staged": "^16.4.0",
		"oxfmt": "^0.45.0",
		"oxlint": "^1.60.0",
		"oxlint-tsgolint": "^0.21.1",
		"postcss": "^8.5.10",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.3",
		"vite": "^8.0.8",
		"vite-plugin-pwa": "^1.2.0",
		"wrangler": "^4.83.0"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint",
		"*": "oxfmt --no-error-on-unmatched-pattern"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@swc/core",
			"contentful",
			"core-js",
			"core-js-pure",
			"esbuild",
			"sharp",
			"workerd"
		]
	}
}
